{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/login1",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/login1.html",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/login1.html"
      },
      {
        "source": "/Pro",
        "destination": "/Pro.html"
      },
      {
        "source": "/pro",
        "destination": "/Pro.html"
      },
      {
        "source": "/tool",
        "destination": "/tool.html"
      },
      {
        "source": "/Tool",
        "destination": "/tool.html"
      },
      {
        "source": "/tool-terms",
        "destination": "/tool-terms.html"
      }
    ],
    "errorPages": [
      {
        "code": 404,
        "page": "/404.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ]
  }
}
